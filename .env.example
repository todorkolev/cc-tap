# cc-tap HTTP transport configuration.
#
# Copy to .env and fill in. Never commit the real file — it holds MCP_SECRET.
# Every variable below has a CLI equivalent; the CLI flag wins if both are set.

# ---------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------

# "stdio" (default) or "http". stdio is what local clients like Claude Code and
# Claude Desktop use; http is what a cloud client such as Claude voice mode needs.
CC_TAP_TRANSPORT=http

# Bind address. Defaults to 127.0.0.1, which is correct for a local-only server.
# Set 0.0.0.0 when a reverse proxy or another container has to reach it —
# a service on 127.0.0.1 inside a container is invisible to the proxy.
CC_TAP_HOST=0.0.0.0

# Bind port (default 8787).
CC_TAP_PORT=8787

# The public HTTPS base URL clients actually reach, used as the OAuth issuer and
# resource identifier. REQUIRED behind a TLS proxy: it cannot be inferred from
# the bind address, and if it is wrong the OAuth flow fails. No trailing slash.
CC_TAP_PUBLIC_URL=https://cc-tap.example.com

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# Required for --transport http. Gates the OAuth consent page and derives the
# pre-registered client ID/secret. Generate with:  openssl rand -hex 32
MCP_SECRET=

# Where issued OAuth tokens are persisted, so connections survive a restart.
# Must be writable by the service user; created 0600.
CC_TAP_TOKEN_STORE=~/.cc-tap/oauth-tokens.json

# Skip the consent page and approve every authorization automatically.
# DANGEROUS: with dynamic client registration enabled this lets anyone who can
# reach the URL connect. Left unset (the default) for good reason.
# CC_TAP_OAUTH_AUTO_APPROVE=0

# Stateless streamable HTTP (default on). Each request is self-contained, so no
# session state has to survive restarts or stick to one instance behind a proxy.
# CC_TAP_STATELESS_HTTP=1

# ---------------------------------------------------------------------------
# Claude Code credentials
# ---------------------------------------------------------------------------
# cc-tap resolves the Anthropic token in this order:
#   1. CLAUDE_CODE_OAUTH_TOKEN
#   2. macOS Keychain
#   3. ~/.claude/.credentials.json
#
# Do NOT set CLAUDE_CODE_OAUTH_TOKEN for a long-running deployment. That token
# expires and is refreshed by the running Claude Code CLI, which rewrites the
# credentials file; a value pinned in the environment will expire and stay
# expired. Let cc-tap read the live file instead — it re-reads on 401.

# CLAUDE_CODE_OAUTH_TOKEN=

# Optional: skip the org-UUID lookup API call.
# CCR_ORG_UUID=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# DEBUG, INFO (default), WARNING, ERROR.
CC_TAP_LOG_LEVEL=INFO
